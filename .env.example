# ── Database ────────────────────────────────────────────────────────────────
# Local dev (SQLite, zero-config):
DATABASE_URL="file:./db/custom.db"
#
# Production (Vercel / hosted): swap Prisma provider to "postgresql" in
# prisma/schema.prisma and point at a hosted Postgres (Neon / Vercel Postgres):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── AI provider (optional) ──────────────────────────────────────────────────
# The app ships with a deterministic scripted fallback, so it runs WITHOUT
# any AI key. To enable the live-LLM path on your own deployment, wire your
# provider inside llmChat() in src/lib/ai.ts and set its key here, e.g.:
# GEMINI_API_KEY="your-key-here"

# ── API auth (optional) ─────────────────────────────────────────────────────
# When set, mutating API routes require this token (Authorization: Bearer or
# x-api-key). Leave unset for the open judge demo. Min 8 chars.
FERRIX_API_TOKEN=

# ── WhatsApp Cloud API (optional) ───────────────────────────────────────────
# WhatsApp Cloud API webhook (docs/CHANNELS.md). All optional: unset =
# open-demo webhook (unsigned POSTs accepted for local testing).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
